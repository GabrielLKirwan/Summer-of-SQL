--Which item was the most popular for each customer?

WITH first_week_sales AS( 
Select
    sales.customer_id,
    product_id,
    order_date,
    join_date,
    datediff('days', join_date,order_date) as days_as_member
FROM SALES 
    INNER JOIN members ON sales.customer_id = members.customer_id
    WHERE days_as_member BETWEEN 0 and 6
),

Week_one_points AS( 
Select
    customer_id,
    fws.product_id,
    order_date,
    price * 2 as points
from first_week_sales fws
    INNER JOIN Menu on Menu.PRODUCT_ID = fws.PRODUCT_ID
),

not_first_week_sales AS( 
Select
    sales.customer_id,
    sales.product_id,
    order_date,
    join_date,
    datediff('days', join_date,order_date) as days_as_member
FROM SALES 
    INNER JOIN members ON sales.customer_id = members.customer_id
    WHERE days_as_member > 6
)
, 

points_not_first_week_sales as (
    SELECT
    customer_id,
    menu.product_id,
    order_date,
        CASE menu.PRODUCT_ID WHEN 
        1 THEN menu.price * 2 
        END as Points
FROM not_first_week_sales as nfws
INNER JOIN MENU on nfws.product_id = menu.product_id
)


,
Points as (
Select*
from week_one_points
union
SELECT* 
from points_not_first_week_sales
),

final as (
select
customer_id,
Sum(points)
from Points
GROUP BY customer_id
ORDER BY customer_id
)

select * from final
